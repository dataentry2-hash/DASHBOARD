const $  = (id) => document.getElementById(id);
const fmt = (n) => Number(n || 0).toLocaleString('en-IN');
const sum = (arr, key) => arr.reduce((a, b) => a + Number(b[key] || 0), 0);
const esc = (s) => String(s).replace(/[&<>"']/g, c =>
  ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
const numClass = (v) => v > 0 ? 'pos' : (v < 0 ? 'neg' : 'zero');

