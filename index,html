   ========================================================= */
$('togglePw').addEventListener('click', () => {
  const p = $('password');
  p.type = p.type === 'password' ? 'text' : 'password';
  $('togglePw').textContent = p.type === 'password' ? '👁️' : '🙈';
});

document.querySelectorAll('.fill').forEach(btn => {
  btn.addEventListener('click', () => {
    $('username').value = btn.dataset.u;
    $('password').value = btn.dataset.p;
    $('loginError').classList.add('hidden');
  });
});

$('loginForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const u = $('username').value.trim().toLowerCase();
  const p = $('password').value.trim();

  const found = USERS.find(x => x.username.toLowerCase() === u && x.password === p);

  if (!found) {
    $('loginErrorText').textContent = 'Invalid username or password. Please try again.';
    $('loginError').classList.remove('hidden');
    $('password').value = '';
    return;
  }
  if (found.status !== 'active') {
    $('loginErrorText').textContent = 'This account is not active.';
    $('loginError').classList.remove('hidden');
    return;
  }

  $('loginError').classList.add('hidden');
  currentUser = found;
  startApp();
});

function startApp() {
  $('loginScreen').classList.add('hidden');
  $('app').classList.remove('hidden');

  const name = currentUser.username;
  $('sideUser').textContent   = name;
  $('sideRole').textContent   = currentUser.role;
  $('sideAvatar').textContent = name.charAt(0).toUpperCase();
  $('welcomeName').textContent = name.charAt(0).toUpperCase() + name.slice(1);

  const pill = $('rolePill');
  pill.textContent = currentUser.role.toUpperCase();
  pill.classList.toggle('user', currentUser.role !== 'admin');

  // admin-only nav
  document.querySelectorAll('.admin-only').forEach(el => {
    el.style.display = currentUser.role === 'admin' ? '' : 'none';
  });

  renderAll();
  navigate('dashboard');
}

