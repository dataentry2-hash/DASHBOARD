function renderDashboard() {
  const totalStock   = sum(INVENTORY, 'inv');
  const totalBlocked = sum(INVENTORY, 'blocked');
  const totalBad     = sum(INVENTORY, 'bad');
  const totalBalance = sum(KHATA, 'balance');
  const totalDelivery = DELIVERY.reduce((a,d) => a + d.main + d.main2 + d.rfs + d.second, 0);

  $('bStatSku').textContent       = INVENTORY.length;
  $('bStatStock').textContent     = fmt(totalStock);
  $('bStatDelivery').textContent  = fmt(totalDelivery);
  $('bStatBalance').textContent   = '₹' + fmt(totalBalance);

  $('kpiInv').textContent     = fmt(totalStock);
  $('kpiInvSub').textContent  = `Across ${INVENTORY.length} SKUs`;
  $('kpiBlocked').textContent = fmt(totalBlocked);
  $('kpiBad').textContent     = fmt(totalBad);
  $('kpiBal').textContent     = '₹' + fmt(totalBalance);
  $('kpiBalSub').textContent  = `${KHATA.length} khatas`;

  const top = [...KHATA].sort((a,b) => b.balance - a.balance).slice(0, 8);
  $('topKhataBody').innerHTML = top.map((k, i) => `
    <tr>
      <td>${i + 1}</td>
      <td><b>${esc(k.name)}</b></td>
      <td class="num">₹${fmt(k.balance)}</td>
    </tr>`).join('');
}

/* =========================================================
