   ========================================================= */
function renderInventory(filter = '') {
  const q = filter.trim().toLowerCase();
  const rows = INVENTORY.filter(r =>
    !q || r.sku.toLowerCase().includes(q) || r.cat.toLowerCase().includes(q));

  $('badgeInv').textContent = INVENTORY.length;

  if (!rows.length) {
    $('invBody').innerHTML = `<tr><td colspan="5"><div class="empty">
      <span class="big">🔍</span>No items match "<b>${esc(filter)}</b>"</div></td></tr>`;
    $('invFoot').innerHTML = '';
    return;
  }

  $('invBody').innerHTML = rows.map(r => `
    <tr>
      <td class="sku">${esc(r.sku)}</td>
      <td><span class="tag cat">${esc(r.cat)}</span></td>
      <td class="num ${numClass(r.inv)}">${fmt(r.inv)}</td>
      <td class="num ${r.blocked ? 'pos' : 'zero'}">${fmt(r.blocked)}</td>
      <td class="num ${r.bad ? 'neg' : 'zero'}">${fmt(r.bad)}</td>
    </tr>`).join('');

  $('invFoot').innerHTML = `
    <tr>
      <td>TOTAL (${rows.length} items)</td>
      <td></td>
      <td class="num">${fmt(sum(rows,'inv'))}</td>
      <td class="num">${fmt(sum(rows,'blocked'))}</td>
      <td class="num">${fmt(sum(rows,'bad'))}</td>
    </tr>`;

  // KPI (always full dataset)
  $('invSku').textContent     = INVENTORY.length;
  $('invStock').textContent   = fmt(sum(INVENTORY,'inv'));
  $('invBlocked').textContent = fmt(sum(INVENTORY,'blocked'));
  $('invBad').textContent     = fmt(sum(INVENTORY,'bad'));
}

/* =========================================================
   RENDER: DELIVERY
   ========================================================= */
function renderDelivery(filter = '') {
  const q = filter.trim().toLowerCase();
  const rows = DELIVERY.filter(r => !q || r.khata.toLowerCase().includes(q));

  $('badgeDel').textContent = DELIVERY.length;

  const main   = sum(DELIVERY,'main');
  const main2  = sum(DELIVERY,'main2');
  const rfs    = sum(DELIVERY,'rfs');
  const second = sum(DELIVERY,'second');

  $('delMain').textContent  = fmt(main);
  $('delMain2').textContent = fmt(main2);
  $('delRfs').textContent   = fmt(rfs);
  $('delTotal').textContent = fmt(main + main2 + rfs + second);

  if (!rows.length) {
    $('delBody').innerHTML = `<tr><td colspan="6"><div class="empty">
      <span class="big">🔍</span>No khata matches "<b>${esc(filter)}</b>"</div></td></tr>`;
    $('delFoot').innerHTML = '';
    return;
  }

  $('delBody').innerHTML = rows.map(r => {
    const total = r.main + r.main2 + r.rfs + r.second;
    return `<tr>
      <td><b>${esc(r.khata)}</b></td>
      <td class="num ${r.main ? '' : 'zero'}">${fmt(r.main)}</td>
      <td class="num ${r.main2 ? '' : 'zero'}">${fmt(r.main2)}</td>
      <td class="num ${r.rfs ? 'neg' : 'zero'}">${fmt(r.rfs)}</td>
      <td class="num ${r.second ? 'pos' : 'zero'}">${fmt(r.second)}</td>
      <td class="num"><b>${fmt(total)}</b></td>
    </tr>`;
  }).join('');

  const t = (k) => sum(rows, k);
  $('delFoot').innerHTML = `
    <tr>
      <td>GRAND TOTAL (${rows.length})</td>
      <td class="num">${fmt(t('main'))}</td>
      <td class="num">${fmt(t('main2'))}</td>
      <td class="num">${fmt(t('rfs'))}</td>
      <td class="num">${fmt(t('second'))}</td>
      <td class="num">${fmt(t('main') + t('main2') + t('rfs') + t('second'))}</td>
    </tr>`;
}

/* =========================================================
   RENDER: KHATA
   ========================================================= */
function renderKhata(filter = '') {
  const q = filter.trim().toLowerCase();
  const rows = KHATA.filter(r => !q || r.name.toLowerCase().includes(q));

  $('badgeKha').textContent = KHATA.length;

  const total = sum(KHATA, 'balance');
  const max   = KHATA.reduce((a,b) => b.balance > a.balance ? b : a, KHATA[0] || {balance:0,name:'—'});

  $('khaCount').textContent   = KHATA.length;
  $('khaTotal').textContent   = '₹' + fmt(total);
  $('khaMax').textContent     = '₹' + fmt(max.balance);
  $('khaMaxName').textContent = max.name;
  $('khaAvg').textContent     = '₹' + fmt(Math.round(total / (KHATA.length || 1)));

  if (!rows.length) {
    $('khaBody').innerHTML = `<tr><td colspan="3"><div class="empty">
      <span class="big">🔍</span>No khata matches "<b>${esc(filter)}</b>"</div></td></tr>`;
    $('khaFoot').innerHTML = '';
    return;
  }

  $('khaBody').innerHTML = rows.map((k, i) => `
    <tr>
      <td>${i + 1}</td>
      <td><b>${esc(k.name)}</b></td>
      <td class="num ${k.balance < 0 ? 'neg' : ''}">₹${fmt(k.balance)}</td>
    </tr>`).join('');

  $('khaFoot').innerHTML = `
    <tr>
      <td colspan="2">TOTAL (${rows.length} khatas)</td>
      <td class="num">₹${fmt(sum(rows,'balance'))}</td>
    </tr>`;
}

/* =========================================================
   RENDER: USERS
   ========================================================= */
function renderUsers() {
  $('usersBody').innerHTML = USERS.map((u, i) => `
    <tr>
      <td>${i + 1}</td>
      <td><b style="text-transform:capitalize;">${esc(u.username)}</b></td>
      <td class="sku">${'•'.repeat(u.password.length)} <span style="color:#94a3b8;font-family:inherit;">(${esc(u.password)})</span></td>
      <td><span class="tag" style="${u.role === 'admin'
          ? 'background:#fee2e2;color:#b91c1c;'
          : 'background:#e0e7ff;color:#4338ca;'}">${esc(u.role)}</span></td>
      <td><span class="tag" style="background:#dcfce7;color:#15803d;">● ${esc(u.status)}</span></td>
    </tr>`).join('');
}

/* =========================================================
   RENDER ALL + SEARCH BINDINGS
   ========================================================= */
function renderAll() {
  renderDashboard();
  renderInventory();
  renderDelivery();
  renderKhata();
  renderUsers();
}

$('searchInv').addEventListener('input', e => renderInventory(e.target.value));
$('searchDel').addEventListener('input', e => renderDelivery(e.target.value));
$('searchKha').addEventListener('input', e => renderKhata(e.target.value));

/* Enter key on username → focus password */
$('username').addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); $('password').focus(); }
});
</script>
